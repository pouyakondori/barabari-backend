{
  "name": "barabari-backend",
  "version": "0.0.0",
  "description": "GraphQL API server for the Barabari constitutional analysis platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --swc src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node --swc src/seed/seed.ts",
    "lint": "eslint src/",
    "test": "vitest",
    "migrate:up": "migrate-mongo up -f migrate-mongo-config.mjs",
    "migrate:down": "migrate-mongo down -f migrate-mongo-config.mjs",
    "migrate:status": "migrate-mongo status -f migrate-mongo-config.mjs",
    "migrate:create": "migrate-mongo create -f migrate-mongo-config.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "minio": "^8.0.7",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.21",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
